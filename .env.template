# ============================================================================
# DEVOPS PLATFORM - Environment Variables Template
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.template .env
# ============================================================================

# ============================================================================
# Cluster / plataforma
# ============================================================================
# Nome do cluster k3d.
CLUSTER_NAME=devops-lab

# Diretório no HOST para volumes persistentes do cluster (Postgres, storage).
# Default fica no disco interno do Mac, NÃO depende de SSD externo montado.
# Pode apontar para um SSD externo se quiser: DATA_DIR=/Volumes/Backup/devops-lab
DATA_DIR=$HOME/.devops-lab

# Repo Git DESTA infra, que o ArgoCD observa. Vazio = `git remote origin`.
# INFRA_REPO_URL=https://github.com/infra-devops-full/infra.git
# Branch desse repo que o ArgoCD acompanha (default: main).
# INFRA_BRANCH=main

# ============================================================================
# GitHub Container Registry (GHCR)
# ============================================================================
# Token em: https://github.com/settings/tokens
# Scopes necessários: read:packages (write/delete/repo se for publicar)
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_USERNAME=your_github_username

# ============================================================================
# Como usar
# ============================================================================
# 1. Crie seu GitHub Personal Access Token
# 2. Copie este arquivo:    cp .env.template .env
# 3. Edite o .env e preencha GITHUB_TOKEN / GITHUB_USERNAME
# 4. (Opcional) ajuste DATA_DIR / CLUSTER_NAME
# 5. Rode o setup:          make setup
#
# NUNCA commite o arquivo .env! Ele já está no .gitignore
# ============================================================================
