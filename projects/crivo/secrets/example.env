# =============================================================================
# Segredos do crivo-be → Secret `app-secrets` (scripts/apply-secrets.sh)
# -----------------------------------------------------------------------------
# Valores FICTÍCIOS de lab: bastam para a API subir. Para valores reais, copie
# para secrets/develop.env ou secrets/prod.env (gitignored) e preencha:
#   cp secrets/example.env secrets/develop.env
#   make secrets PROJECT=crivo ENV=develop
#
# Formato kubectl --from-env-file: KEY=valor, SEM aspas.
# DATABASE_URL e REDIS_URL NÃO vão aqui — a plataforma cria os Secrets
# `postgres` e `redis` a partir do project.yaml.
# =============================================================================

# -- Auth ---------------------------------------------------------------------
JWT_SECRET=lab-jwt-secret-troque-em-producao
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000
INBOUND_WEBHOOK_TOKEN=lab-inbound-token

# -- Bull Board (painel das filas) --------------------------------------------
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin

# -- WhatsApp (MESSAGING_PROVIDER=fake no values → nada é enviado) -------------
EVOLUTION_API_URL=http://evolution.invalid
EVOLUTION_API_KEY=stub
EVOLUTION_INSTANCE=stub
META_WHATSAPP_TOKEN=stub
META_WHATSAPP_PHONE_NUMBER_ID=stub
META_API_VERSION=v21.0

# -- IA -----------------------------------------------------------------------
DEEPSEEK_API_KEY=stub
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_MS=15000

# -- Cloudinary ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=stub
CLOUDINARY_API_KEY=stub
CLOUDINARY_API_SECRET=stub

# -- Stripe (chaves de teste) -------------------------------------------------
STRIPE_SECRET_KEY=sk_test_stub
STRIPE_PUBLISHABLE_KEY=pk_test_stub
STRIPE_WEBHOOK_SECRET=whsec_stub

# -- E-mail -------------------------------------------------------------------
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=stub
SMTP_PASSWORD=stub
MAIL_FROM=no-reply@crivo.local
